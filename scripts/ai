#!/usr/bin/env bash
# `ai` — unified launcher for Claude Code and Codex CLI inside the runtime.
set -euo pipefail
IFS=$'\n\t'

RED=$'\033[31m'
BOLD=$'\033[1m'
RESET=$'\033[0m'

NPM_GLOBAL_BIN=${NPM_GLOBAL_BIN:-/usr/local/share/npm-global/bin}
export PATH="${NPM_GLOBAL_BIN}:$HOME/.composer/vendor/bin:$HOME/.local/bin:${PATH}"

resolve_tool() {
    local tool=$1
    if command -v "$tool" >/dev/null 2>&1; then
        command -v "$tool"
        return 0
    fi
    if [[ -x "${NPM_GLOBAL_BIN}/${tool}" ]]; then
        printf '%s\n' "${NPM_GLOBAL_BIN}/${tool}"
        return 0
    fi
    echo "Required command not found: ${tool}" >&2
    echo "Expected it on PATH or at ${NPM_GLOBAL_BIN}/${tool}." >&2
    exit 127
}

warn_yolo() {
    local agent=$1
    {
        printf '%s%s' "$RED" "$BOLD"
        printf '!!  YOLO mode: %s with all permission prompts disabled.\n' "$agent"
        printf '!!  The agent can run any command and modify any file in the workspace.\n'
        printf '!!  Make sure your network firewall and tenant isolation are intact.\n'
        printf '%s' "$RESET"
    } >&2
}

usage() {
    cat <<'EOF'
Usage: ai <command> [args...]

Commands:
  claude [args...]            Launch Claude Code with permission prompts disabled.
  claude --yolo [args...]     Same as `ai claude`; kept for muscle memory.
  codex [args...]             Launch Codex with danger-full-access sandbox, never approval, and Goals enabled.
  codex --yolo [args...]      Same as `ai codex`; kept for muscle memory.
  both [--yolo]               Open a tmux split: Claude on the left, Codex on the right.
  firewall                    Re-run the egress firewall (sudo).
  help                        Show this help.
EOF
}

run_claude() {
    local claude_bin
    claude_bin=$(resolve_tool claude)
    if [[ "${1:-}" == "--yolo" ]]; then
        shift
    fi
    warn_yolo "Claude Code"
    exec "$claude_bin" --dangerously-skip-permissions "$@"
}

run_codex() {
    local codex_bin
    codex_bin=$(resolve_tool codex)
    if [[ "${1:-}" == "--yolo" ]]; then
        shift
    fi
    exec "$codex_bin" --enable goals --sandbox danger-full-access --ask-for-approval never "$@"
}

run_both() {
    local yolo=""
    if [[ "${1:-}" == "--yolo" ]]; then
        yolo=" --yolo"
        shift
    fi
    if ! command -v tmux >/dev/null 2>&1; then
        echo "tmux is not installed — cannot run split mode." >&2
        exit 1
    fi
    local session="ai-both-$$"
    tmux new-session -d -s "$session" -n agents "ai claude${yolo}"
    tmux split-window -h -t "$session:agents" "ai codex${yolo}"
    tmux select-pane -t "$session:agents.0"
    exec tmux attach -t "$session"
}

run_firewall() {
    exec sudo /usr/local/bin/init-firewall.sh
}

case "${1:-help}" in
    claude)
        shift
        run_claude "$@"
        ;;
    codex)
        shift
        run_codex "$@"
        ;;
    both)
        shift
        run_both "$@"
        ;;
    firewall)
        run_firewall
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: ${1}" >&2
        usage
        exit 2
        ;;
esac
